#!/bin/sh
set -eu

repo=${1:?usage: scripts/update-agenthub-event-timeline /path/to/agenthub [revision]}
revision=${2:-402c286bbf38e190b03e99f17d91baef74119b18}
expected_revision=402c286bbf38e190b03e99f17d91baef74119b18
expected_iife_sha=6211dce0fc50d79b120ccda283e119e1c56743c3fa03440e75b5fbc80ea9da52
expected_esm_sha=b2cfd1ce274028fc9b9037d6ccacbcfa712eee2f55b482dd012235cdac3ce1fc

resolved=$(git -C "$repo" rev-parse "$revision^{commit}")
if [ "$resolved" != "$expected_revision" ]; then
  echo "revision $resolved is not the pinned AgentHub revision $expected_revision" >&2
  exit 1
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
git -C "$repo" archive "$resolved" packages/event-timeline | tar -x -C "$tmp"
package="$tmp/packages/event-timeline"
(cd "$package" && npm run build && npm test)

actual_iife_sha=$(shasum -a 256 "$package/dist/event-timeline.iife.js" | awk '{print $1}')
actual_esm_sha=$(shasum -a 256 "$package/dist/event-timeline.mjs" | awk '{print $1}')
if [ "$actual_iife_sha" != "$expected_iife_sha" ]; then
  echo "IIFE SHA-256 mismatch: got $actual_iife_sha, want $expected_iife_sha" >&2
  exit 1
fi
if [ "$actual_esm_sha" != "$expected_esm_sha" ]; then
  echo "ESM SHA-256 mismatch: got $actual_esm_sha, want $expected_esm_sha" >&2
  exit 1
fi

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
module="$root/web/vendor/agenthub-event-timeline"
fixtures="$root/internal/serve/testdata/agenthub-event-timeline"
mkdir -p "$module" "$fixtures"
cp "$package/dist/event-timeline.mjs" "$module/index.mjs"
cp "$package/dist/manifest.json" "$module/upstream-manifest.json"
cp "$package/LICENSE" "$module/LICENSE"
cp "$package/fixtures/canonical-events.json" "$fixtures/canonical-events.json"
cp "$package/fixtures/pagination-fragments.json" "$fixtures/pagination-fragments.json"
cp "$package/snapshots/canonical-events.timeline.json" "$fixtures/canonical-events.timeline.json"
cp "$package/snapshots/pagination-fragments.timeline.json" "$fixtures/pagination-fragments.timeline.json"

echo "updated @agenthub/event-timeline 1.0.0 from $resolved ($actual_esm_sha)"
